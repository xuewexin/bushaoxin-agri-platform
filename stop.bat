@echo off
chcp 65001 >nul
echo ================================================================
echo  “不烧心”农产品直播电商产销对接平台 - 一键关闭服务进程脚本
echo ================================================================

echo 正在查找并关闭 8080 端口 (SpringBoot 后端)...
for /f "tokens=5" %%a in ('netstat -ano ^| findstr :8080') do (
    taskkill /F /PID %%a 2>nul
)

echo 正在查找并关闭 3000 端口 (Vite 前端)...
for /f "tokens=5" %%a in ('netstat -ano ^| findstr :3000') do (
    taskkill /F /PID %%a 2>nul
)

echo ================================================================
echo  后端 (8080) 与 前端 (3000) 进程已全部成功关闭！
echo ================================================================
pause
